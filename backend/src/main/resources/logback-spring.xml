<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置。

  为什么不用 application.yml 里的 logging.* 就够了？
  那个只能设级别，管不了「按天+按大小滚动」「错误日志单独一份」「异步写」。
  线上排查问题靠的是日志文件，这几样是必需的。

  为什么错误日志要单独一个文件？
  因为运维侧可以只对 error.log 配告警，不用被 INFO 淹没；
  也可以只把 error.log 拉进日志平台，省存储。
-->
<configuration>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name"
                    defaultValue="used-digital-platform"/>

    <!-- 日志目录：容器里挂到数据卷上，宿主机能直接看到 -->
    <property name="LOG_DIR" value="${LOG_DIR:-./logs}"/>
    <property name="PLAIN_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>
    <property name="COLOR_PATTERN"
              value="%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{36}) - %msg%n"/>

    <!-- ==================== 1. 控制台 ==================== -->

    <appender name="CONSOLE_COLOR" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${COLOR_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 生产/容器用不带颜色的一份。
         ANSI 转义码会污染 docker logs 输出，也会让日志采集工具解析出乱码。 -->
    <appender name="CONSOLE_PLAIN" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PLAIN_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== 2. 全量日志文件 ==================== -->
    <!--
      SizeAndTimeBasedRollingPolicy：按天切 + 单文件超 50MB 再切。
      只按天切的话，某天出问题刷了大量日志会撑爆磁盘；只按大小切的话，
      找「昨天下午的日志」很麻烦。两个一起用才靠谱。
      压缩成 .gz，30 天后自动删，总量封顶 2GB。
    -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/history/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PLAIN_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== 3. 只收 ERROR 的文件 ==================== -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/history/error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PLAIN_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== 4. 异步包装 ==================== -->
    <!--
      写文件是同步 IO，高并发下会拖慢业务线程。
      AsyncAppender 把日志丢进队列由后台线程刷盘。
      discardingThreshold=0：队列满时也不丢日志（默认会丢弃 INFO 以下），
      宁可稍微阻塞也不能丢 —— 排查线上问题时最怕「日志少了一段」。
    -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <appender-ref ref="FILE"/>
    </appender>

    <appender name="ASYNC_ERROR_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <appender-ref ref="ERROR_FILE"/>
    </appender>

    <!-- ==================== 5. 按 profile 装配 ==================== -->

    <springProfile name="local,dev,default">
        <root level="INFO">
            <appender-ref ref="CONSOLE_COLOR"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_ERROR_FILE"/>
        </root>
    </springProfile>

    <springProfile name="prod,docker">
        <root level="INFO">
            <appender-ref ref="CONSOLE_PLAIN"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_ERROR_FILE"/>
        </root>
    </springProfile>

</configuration>

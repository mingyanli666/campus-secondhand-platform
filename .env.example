# ============================================================
# 复制成 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 排除，不会进版本库
# ============================================================

# MySQL root 密码（同时给后端连库用）
MYSQL_ROOT_PASSWORD=change-me-strong-password

# JWT 签名密钥。必须是随机值，且至少 32 字节。
# 用仓库里 application.yml 的默认值等于把 token 伪造能力公开出去。
# 生成方式：openssl rand -base64 48
JWT_SECRET=change-me-openssl-rand-base64-48-at-least-32-bytes

# 前端对外端口，80 被占用时改成别的（比如 8000）
WEB_PORT=80
